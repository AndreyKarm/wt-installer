{
  "manifest_version": 3,
  "name": "WT Local Downloader",
  "version": "1.0",
  "description": "Adds a 'Download locally' button to War Thunder Live posts",
  "host_permissions": [
    "https://live.warthunder.com/*",
    "http://localhost:4316/*"
  ],

  "icons": {
    "48": "assets/icon.ico"
  },

  "content_scripts": [
    {
      "matches": ["https://live.warthunder.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],

  "background": {
    "scripts": ["background.js"]
  }
}
